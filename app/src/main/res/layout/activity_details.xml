<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER IMAGE + TITRE -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="280dp">

            <!-- Image de fond -->
            <ImageView
                android:id="@+id/iv_backdrop"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@mipmap/ic_placeholder"
                android:contentDescription="Backdrop"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Dégradé noir transparent en bas pour lisibilité du texte -->
            <View
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:background="@drawable/gradient_header"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Bouton Retour -->
            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_back"
                android:layout_margin="16dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Titre + Slogan + Date — bas gauche -->
            <LinearLayout
                android:id="@+id/ll_title_block"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingBottom="14dp"
                android:paddingEnd="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tv_rating">

                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Foundation"
                    android:textColor="@color/bleu"
                    android:textSize="28sp"
                    android:fontFamily="@font/rajdhani_bold" />

                <TextView
                    android:id="@+id/tv_quote"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="&quot;All empires fall&quot;"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:fontFamily="@font/rajdhani_regular"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/tv_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="24 septembre 2021"
                    android:textColor="@color/gray"
                    android:textSize="14sp"
                    android:fontFamily="@font/rajdhani_regular"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <!-- Note — bas droite -->
            <TextView
                android:id="@+id/tv_rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="8"
                android:textColor="@color/bleu"
                android:textSize="48sp"
                android:fontFamily="@font/rajdhani_bold"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Séparateur -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/bleu"
            android:alpha="0.9"/>

        <!-- SYNOPSIS -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Synopsis"
            android:textColor="@color/bleu"
            android:textSize="20sp"
            android:fontFamily="@font/rajdhani_bold"
            android:paddingHorizontal="16dp"
            android:paddingBottom="5dp"
            android:paddingTop="20dp" />

        <TextView
            android:id="@+id/tv_synopsis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Foundation retrace le voyage épique d'une bande d'exilés pour sauver l'humanité..."
            android:textColor="@color/white"
            android:textSize="15sp"
            android:lineSpacingExtra="6dp"
            android:paddingHorizontal="16dp"
            android:paddingBottom="20dp" />

        <!-- Séparateur -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/bleu"
            android:alpha="0.9"
            android:layout_marginBottom="20dp"
            android:layout_marginTop="5dp"/>

        <!-- STATISTIQUES -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="20dp"
            android:background="@color/black">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Saisons"
                    android:textColor="@color/white"
                    android:fontFamily="@font/rajdhani_bold"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/tv_seasons"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="03"
                    android:textColor="@color/bleu"
                    android:textSize="24sp"
                    android:fontFamily="@font/rajdhani_bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Episodes"
                    android:textColor="@color/white"
                    android:fontFamily="@font/rajdhani_bold"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/tv_episodes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="30"
                    android:textColor="@color/bleu"
                    android:textSize="24sp"
                    android:fontFamily="@font/rajdhani_bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Heures"
                    android:textColor="@color/white"
                    android:fontFamily="@font/rajdhani_bold"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/tv_hours"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="28"
                    android:textColor="@color/bleu"
                    android:textSize="24sp"
                    android:fontFamily="@font/rajdhani_bold" />
            </LinearLayout>

        </LinearLayout>

        <!-- Séparateur -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/bleu"
            android:alpha="0.9"
            android:layout_marginBottom="20dp"
            android:layout_marginTop="5dp"/>

        <!-- Plateforme de diffusion -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Plateforme de diffusion"
            android:textColor="@color/bleu"
            android:textSize="17sp"
            android:fontFamily="@font/rajdhani_bold"
            android:paddingHorizontal="16dp"
            android:paddingBottom="5dp" />

        <TextView
            android:id="@+id/tv_platform"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="En cours"
            android:textColor="@color/gray"
            android:textSize="15sp"
            android:lineSpacingExtra="6dp"
            android:paddingHorizontal="16dp"
            android:paddingBottom="20dp" />

        <!-- Séparateur -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/bleu"
            android:alpha="0.9"
            android:layout_marginBottom="20dp"
            android:layout_marginTop="5dp"/>

        <!-- FORMULAIRE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Votre avis titre -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Votre avis"
                android:textColor="@color/bleu"
                android:textSize="26sp"
                android:fontFamily="@font/rajdhani_bold"
                android:gravity="center"
                android:layout_marginBottom="20dp" />

            <!-- Status Avis + Note sur la même ligne -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <!-- Status label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Status"
                    android:textColor="@color/bleu"
                    android:textSize="15sp"
                    android:fontFamily="@font/rajdhani_bold"
                    android:layout_marginEnd="8dp" />

                <!-- Spinner Status Avis -->
                <Spinner
                    android:id="@+id/spinner_avis_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="16dp" />

                <!-- Note label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Note"
                    android:textColor="@color/bleu"
                    android:textSize="15sp"
                    android:fontFamily="@font/rajdhani_bold"
                    android:layout_marginEnd="8dp" />

                <!-- EditText Note -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layout_note"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:boxCornerRadiusTopStart="8dp"
                    app:boxCornerRadiusTopEnd="8dp"
                    app:boxCornerRadiusBottomStart="8dp"
                    app:boxCornerRadiusBottomEnd="8dp"
                    app:boxStrokeColor="@color/bleu"
                    app:boxStrokeWidth="1.5dp"
                    app:boxStrokeWidthFocused="1.5dp"
                    app:boxBackgroundColor="@color/black"
                    app:boxBackgroundMode="outline"
                    app:hintEnabled="false"
                    app:errorEnabled="true">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_note"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@null"
                        android:inputType="number"
                        android:hint="Note /5"
                        android:textColor="@color/white"
                        android:textColorHint="@color/gray"
                        android:textSize="15sp"
                        android:gravity="center"
                        android:fontFamily="@font/rajdhani_regular" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <!-- Label Avis -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Avis"
                android:textColor="@color/bleu"
                android:fontFamily="@font/rajdhani_bold"
                android:textSize="15sp"
                android:layout_marginBottom="6dp" />

            <!-- Champ Avis -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_avis"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxCornerRadiusTopStart="8dp"
                app:boxCornerRadiusTopEnd="8dp"
                app:boxCornerRadiusBottomStart="8dp"
                app:boxCornerRadiusBottomEnd="8dp"
                app:boxStrokeColor="@color/bleu"
                app:boxStrokeWidth="1.5dp"
                app:boxStrokeWidthFocused="1.5dp"
                app:boxBackgroundColor="@color/black"
                app:boxBackgroundMode="outline"
                app:hintEnabled="false"
                app:errorEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_avis"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:background="@null"
                    android:hint="Votre avis"
                    android:inputType="textMultiLine"
                    android:gravity="top"
                    android:padding="12dp"
                    android:textColor="@color/white"
                    android:textColorHint="@color/gray"
                    android:textSize="15sp"
                    android:fontFamily="@font/rajdhani_regular" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Date de visionnage -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Date de visionnage"
                android:textColor="@color/bleu"
                android:textSize="15sp"
                android:fontFamily="@font/rajdhani_bold"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="6dp"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_date_visionnage"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxCornerRadiusTopStart="8dp"
                app:boxCornerRadiusTopEnd="8dp"
                app:boxCornerRadiusBottomStart="8dp"
                app:boxCornerRadiusBottomEnd="8dp"
                app:boxStrokeColor="@color/bleu"
                app:boxStrokeWidth="1.5dp"
                app:boxStrokeWidthFocused="1.5dp"
                app:boxBackgroundColor="@color/black"
                app:boxBackgroundMode="outline"
                app:hintEnabled="false"
                app:errorEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_date_visionnage"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@null"
                    android:focusable="false"
                    android:clickable="true"
                    android:hint="@string/hint_date_format"
                    android:inputType="none"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/white"
                    android:textColorHint="@color/gray"
                    android:textSize="15sp"
                    android:fontFamily="@font/rajdhani_regular" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Sauvegarder"
                android:textSize="17sp"
                android:textColor="@color/black"
                app:cornerRadius="4dp"
                app:backgroundTint="@color/bleu"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="40dp"
                android:fontFamily="@font/rajdhani_bold" />

        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>