<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- HEADER -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header_settings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="22dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_back"
            android:contentDescription="Retour"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Paramètres"
            android:textColor="@color/bleu"
            android:textSize="27sp"
            android:fontFamily="@font/rajdhani_bold"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toEndOf="@id/btn_back"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Contenu principal -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingHorizontal="24dp"
        android:paddingTop="20dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/header_settings"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ── Section Informations personnelles ── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Informations personnelles"
                android:textColor="@color/bleu"
                android:textSize="20sp"
                android:fontFamily="@font/rajdhani_bold"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="20dp" />

            <!-- Nom utilisateur -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nom utilisateur"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:fontFamily="@font/rajdhani_bold"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_user"
                    app:tint="@color/bleu" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    app:boxCornerRadiusTopStart="8dp"
                    app:boxCornerRadiusTopEnd="8dp"
                    app:boxCornerRadiusBottomStart="8dp"
                    app:boxCornerRadiusBottomEnd="8dp"
                    app:boxStrokeColor="@color/bleu"
                    app:boxStrokeWidth="1.5dp"
                    app:boxStrokeWidthFocused="1.5dp"
                    app:boxBackgroundColor="@color/black"
                    app:boxBackgroundMode="outline"
                    app:hintEnabled="false">

                    <EditText
                        android:id="@+id/et_username"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@null"
                        android:hint="Votre nom"
                        android:inputType="text"
                        android:textColor="@color/white"
                        android:textColorHint="@color/gray"
                        android:textSize="15sp"
                        android:paddingHorizontal="12dp"
                        android:fontFamily="@font/rajdhani_regular" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <!-- Séparateur -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/gray"
                android:alpha="0.3"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp" />

            <!-- Clé API TMDB -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clé API TMDB"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:fontFamily="@font/rajdhani_bold"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_key"
                    app:tint="@color/bleu" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    app:boxCornerRadiusTopStart="8dp"
                    app:boxCornerRadiusTopEnd="8dp"
                    app:boxCornerRadiusBottomStart="8dp"
                    app:boxCornerRadiusBottomEnd="8dp"
                    app:boxStrokeColor="@color/bleu"
                    app:boxStrokeWidth="1.5dp"
                    app:boxStrokeWidthFocused="1.5dp"
                    app:boxBackgroundColor="@color/black"
                    app:boxBackgroundMode="outline"
                    app:hintEnabled="false"
                    app:passwordToggleEnabled="true"
                    app:passwordToggleTint="@color/bleu">

                    <EditText
                        android:id="@+id/et_api_key"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@null"
                        android:hint="Votre clé API"
                        android:inputType="textPassword"
                        android:textColor="@color/white"
                        android:textColorHint="@color/gray"
                        android:textSize="15sp"
                        android:paddingHorizontal="12dp"
                        android:fontFamily="@font/rajdhani_regular" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <!-- Note informative -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="La clé API TMDB est nécessaire pour la recherche de séries. Obtenez-la sur themoviedb.org"
                android:textColor="@color/gray"
                android:textSize="13sp"
                android:fontFamily="@font/rajdhani_regular"
                android:lineSpacingExtra="4dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="32dp" />

            <!-- Bouton Enregistrer -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Enregistrer"
                android:textSize="17sp"
                android:textColor="@color/black"
                app:cornerRadius="30dp"
                app:backgroundTint="@color/bleu"
                android:layout_marginBottom="32dp"
                android:fontFamily="@font/rajdhani_bold" />

            <!-- ── Section Thème ── -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/gray"
                android:alpha="0.3"
                android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thème de l'application"
                android:textColor="@color/bleu"
                android:textSize="20sp"
                android:fontFamily="@font/rajdhani_bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Science-Fiction"
                android:textColor="@color/gray"
                android:textSize="17sp"
                android:fontFamily="@font/rajdhani_regular" />

            <View
                android:layout_width="match_parent"
                android:layout_height="80dp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>