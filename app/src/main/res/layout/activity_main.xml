<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- HEADER -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="18dp"
        android:paddingBottom="10dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Logo + Nom stylisé -->
        <LinearLayout
            android:id="@+id/ll_app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/iv_logo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/logo"
                android:scaleType="fitCenter"
                android:contentDescription="@string/app_name" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_cine"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name_S1"
                    android:fontFamily="@font/rajdhani_bold"
                    android:textColor="@color/white"
                    android:textSize="28sp"
                    android:letterSpacing="0.02" />

                <TextView
                    android:id="@+id/tv_track"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name_S2"
                    android:fontFamily="@font/rajdhani_bold"
                    android:textColor="@color/bleu"
                    android:textSize="28sp"
                    android:letterSpacing="0.02" />
            </LinearLayout>
        </LinearLayout>

        <!-- Icônes à droite -->
        <ImageView
            android:id="@+id/btn_search"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_search"
            android:contentDescription="Rechercher"
            app:layout_constraintEnd_toStartOf="@id/btn_settings"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginEnd="20dp" />

        <ImageView
            android:id="@+id/btn_settings"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_settings"
            android:contentDescription="Paramètres"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- FILTRES (mis en dur) -->
    <HorizontalScrollView
        android:id="@+id/filter_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/header_layout"
        android:layout_marginTop="20dp">

        <LinearLayout
            android:id="@+id/filter_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/filter_tous"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tous"
                android:textSize="17sp"
                android:fontFamily="@font/rajdhani_semibold"
                android:textColor="@color/bleu"
                android:layout_marginEnd="32dp" />

            <TextView
                android:id="@+id/filter_encours"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="En cours"
                android:textSize="17sp"
                android:fontFamily="@font/rajdhani_semibold"
                android:textColor="@color/gray"
                android:layout_marginEnd="32dp" />

            <TextView
                android:id="@+id/filter_termine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Terminé"
                android:textSize="17sp"
                android:fontFamily="@font/rajdhani_semibold"
                android:textColor="@color/gray"
                android:layout_marginEnd="32dp" />

            <TextView
                android:id="@+id/filter_avoir"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="À voir"
                android:textSize="17sp"
                android:fontFamily="@font/rajdhani_semibold"
                android:textColor="@color/gray" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- RECYCLERVIEW -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_series"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingHorizontal="8dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/filter_scroll"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="2" />

    <!-- ÉTAT VIDE -->
    <TextView
        android:id="@+id/tv_empty_state"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:gravity="center"
        android:text="Aucune série n'a été ajoutée pour le moment.\nAjoutez une nouvelle série à partir de la recherche."
        android:textColor="@color/gray"
        android:textSize="15sp"
        android:lineSpacingExtra="6dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/filter_scroll"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>