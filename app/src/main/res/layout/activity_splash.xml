<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Logo -->
    <ImageView
        android:id="@+id/iv_logo"
        android:layout_width="185dp"
        android:layout_height="185dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="180dp"
        android:src="@drawable/logo"
        android:contentDescription="Logo CineTrack" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/iv_logo"
        android:orientation="horizontal"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="65px"

        android:textSize="46sp"
        android:textStyle="bold"
        android:letterSpacing="0.02">
        <TextView
            android:id="@+id/iv_cine_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name_S1"
            android:fontFamily="@font/rajdhani_bold"
            android:textColor="@color/white"
            android:textSize="46sp"
            android:letterSpacing="0.02"/>
        <TextView
            android:id="@+id/iv_cine_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/bleu"
            android:text="@string/app_name_S2"
            android:fontFamily="@font/rajdhani_bold"
            android:textSize="46sp"
            android:letterSpacing="0.02"/>
    </LinearLayout>

<!--    &lt;!&ndash; Nom de l'application &ndash;&gt;-->
<!--    <TextView-->
<!--        android:id="@+id/tv_app_name"-->
<!--        android:layout_width="wrap_content"-->
<!--        android:layout_height="wrap_content"-->
